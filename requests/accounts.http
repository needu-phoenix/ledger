# =================== Accounts ==============================

@base = http://127.0.0.1:8080
### Create Account: valid, default currency
POST {{base}}/accounts
Content-Type: application/json

{"name": "Alice"}

### Create Account: invalid, name cannot be empty
POST {{base}}/accounts
Content-Type: application/json

{"name": " "}

### Create account: missing Content-Type header
POST {{base}}/accounts

{"name": "Alice"}

### Create account: invalid, currency length > 3
POST {{base}}/accounts
Content-Type: application/json

{"name":"Bob","currency":"USDX"}

### Create account: invalid, currency contains numbers
POST {{base}}/accounts
Content-Type: application/json

{"name":"Bob","currency":"U2D"}

### Create account: invalid name, lenght > 100
POST {{base}}/accounts
Content-Type: application/json

{"name":"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}

### Create account: broken JSON
POST {{base}}/accounts
Content-Type: application/json

{"name":
